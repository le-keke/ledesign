---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import About from '@components/About.astro';
import CategoryNav from '@components/CategoryNav.astro';
import Footer from '@components/Footer.astro';
import Logo from '@components/Logo.astro';
import { locales, type Locale } from '@i18n/index';
import { projects } from '@data/projects';
import { researchItems } from '@data/research';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<BaseLayout locale={locale}>
  {/*
    Hash is not sent to the server, so SSR always defaults to Work.
    Set the category on <html> before first paint so #research does not flash Work.
  */}
  <script is:inline slot="head">
    document.documentElement.dataset.homeCategory =
      location.hash === '#research' ? 'research' : 'work';
  </script>

  <div data-home data-active-category="work">
    {/* Scrollable feed — chrome (filter / logo / about / footer) is fixed. */}
    <div class="screen page" data-feed-scroll>
      <main class="grid">
        <div class="grid__main">
          <div class="grid feed" data-feed="work">
            {
              projects.map((project) => {
                const media =
                  project.coverKind === 'video' ? (
                    <video
                      class="cover__media"
                      src={project.cover}
                      width="1200"
                      height="1200"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="auto"
                      aria-label={project.title[locale]}
                    />
                  ) : (
                    <img
                      class="cover__media"
                      src={project.cover}
                      alt={project.title[locale]}
                      width="1200"
                      height="1200"
                      loading="lazy"
                      decoding="async"
                    />
                  );

                return project.locked ? (
                  <div class="cover cover--locked" aria-disabled="true">
                    {media}
                  </div>
                ) : (
                  <a
                    class="cover"
                    href={getRelativeLocaleUrl(locale, `projects/${project.slug}`)}
                    data-astro-prefetch
                  >
                    {media}
                  </a>
                );
              })
            }
          </div>

          {/* Research: title card only (no hover image). Dev marks via "," settings / "r". */}
          <div class="grid feed" data-feed="research" hidden aria-hidden="true">
            {
              researchItems.map((item) => (
                <a
                  class="cover cover--research"
                  href={getRelativeLocaleUrl(locale, `research/${item.slug}`)}
                  data-astro-prefetch
                >
                  <div class="cover__text">
                    <p class="cover__title">{item.title[locale]}</p>
                    <div class="cover__meta">
                      <p>{item.kind[locale]}</p>
                      <p>{item.date}</p>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </main>
    </div>

    {/*
      Two fixed layers (same as lejing): exclusion for nav / logo / footer so they
      stay legible on covers; About stays on a plain layer so it isn’t inverted.
    */}
    <div class="chrome chrome--blend page">
      <div class="grid chrome__grid">
        <div class="grid__main chrome__nav">
          <CategoryNav locale={locale} />
        </div>
        <div class="grid__info chrome__info" id="pad-info-panel">
          <div class="chrome__logo">
            <Logo locale={locale} infoToggle />
          </div>
          <div class="chrome__foot">
            <Footer locale={locale} />
          </div>
        </div>
      </div>
    </div>

    <div class="chrome chrome--plain page">
      <div class="grid chrome__grid">
        <div class="grid__info chrome__aside">
          <About locale={locale} />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .screen {
    padding-block-start: calc(var(--page-edge-y) + var(--leading-flat) + var(--feed-gap-top));
    padding-block-end: var(--page-edge-y);
    min-height: 100svh;
  }

  .feed {
    align-content: start;
    align-items: start;
    row-gap: var(--grid-gutter);
  }

  /* Astro scopes with :where(), so plain [hidden] loses to .grid { display: grid }. */
  .feed[hidden] {
    display: none !important;
  }

  .cover {
    grid-column: span var(--cover-span);
    display: block;
    min-width: 0;
    aspect-ratio: 1;
    overflow: hidden;
    background: transparent;
  }

  .cover__media {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    /* No placeholder fill — subpixel gaps were showing a grey hairline (e.g. on BR). */
    background: transparent;
  }

  .cover--locked {
    cursor: default;
  }

  /*
   * Research text card — Figma Frame 258 (1332:130):
   * Pad = 40/158 of cover width (not a fixed rem) so meta stays visible as cells shrink.
   * Phone: hug-height rectangle → global.css @ max-width 750.
   */
  .cover--research {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding-block: var(--research-cover-pad);
    text-decoration: none;
    color: inherit;
  }

  .cover__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Figma itemSpacing — title → kind/date */
    gap: 0.625rem; /* 10px @1× */
    min-width: 0;
    width: 100%;
    /* Figma card type is 10 / 15 (pre-+10% body); keep site body scale. */
    font-size: var(--text-body);
    font-weight: var(--weight-light);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-intro);
    overflow-wrap: break-word;
  }

  .cover__title,
  .cover__meta p {
    margin: 0;
  }

  .cover__title {
    color: var(--color-fg);
  }

  .cover__meta {
    color: var(--color-fg-muted);
  }

  .cover--research:focus {
    outline: none;
  }

  .cover--research:focus-visible {
    outline: 1px solid var(--color-fg);
    outline-offset: 2px;
  }

  .chrome {
    position: fixed;
    inset-block: var(--page-edge-y);
    inset-inline: 0;
    z-index: 1;
    pointer-events: none;
    overscroll-behavior: none;
  }

  .chrome__grid {
    height: 100%;
    /* Force the single row to fill the chrome height so logo/footer can pin. */
    grid-template-rows: minmax(0, 1fr);
    align-items: stretch;
  }

  .chrome--blend {
    z-index: 2;
    mix-blend-mode: exclusion;
    color: var(--color-exclusion-fg);
  }

  .chrome--plain {
    z-index: 1;
  }

  .chrome__nav,
  .chrome__logo,
  .chrome__foot {
    pointer-events: auto;
  }

  .chrome__nav {
    align-self: start;
  }

  .chrome__info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-self: stretch;
    height: 100%;
    min-height: 0;
  }

  .chrome__logo {
    flex: 0 0 auto;
  }

  .chrome__foot {
    flex: 0 0 auto;
    margin-block-start: auto;
  }

  .chrome__foot :global(.footer),
  .chrome__foot :global(.text-muted) {
    color: var(--color-exclusion-fg-muted);
  }

  .chrome__foot :global(.switch__list a:hover) {
    color: var(--color-exclusion-fg);
  }

  .chrome__aside {
    display: flex;
    align-items: center;
    align-self: stretch;
    height: 100%;
    min-height: 0;
    pointer-events: none;
  }

  .chrome__aside :global(.about) {
    pointer-events: auto;
  }

  /*
   * ≤1240 pad chrome — motion in global.css (1240–751):
   * logo col 4 → left of col 3; About/footer stay mid/bottom in cols 3–4.
   */
  @media (max-width: 1240px) {
    .chrome__nav {
      grid-column: 1 / 3;
      align-self: start;
      z-index: 1;
    }

    .chrome__foot {
      margin-block-start: auto;
    }

    .screen {
      padding-block-start: calc(var(--page-edge-y) + var(--leading-flat) + var(--feed-gap-top));
    }
  }

  @media (max-width: 750px) {
    .chrome__nav {
      grid-column: 1 / -1;
    }

    .screen {
      padding-block-end: calc(2 * var(--page-edge-y));
    }
  }
</style>
