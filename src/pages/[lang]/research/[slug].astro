---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Footer from '@components/Footer.astro';
import { getDictionary, locales, type Locale } from '@i18n/index';
import { researchItems } from '@data/research';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    researchItems.map((item) => ({
      params: { lang, slug: item.slug },
      props: { item },
    })),
  );
}

const locale = Astro.params.lang as Locale;
const { item } = Astro.props as { item: (typeof researchItems)[number] };
const t = getDictionary(locale);
const title = item.title[locale];
---

<BaseLayout locale={locale} route={`research/${item.slug}`} title={title}>
  <div data-detail>
    <div class="screen page">
      <main class="grid">
        <div class="grid__main">
          <div class="detail__media" aria-hidden="true"></div>
        </div>
        <div class="grid__info detail__info">
          <p class="detail__title">{title}</p>
          <p class="text-muted">{item.kind[locale]}</p>
          <p class="text-muted">{item.date}</p>
          <p>
            <a href={getRelativeLocaleUrl(locale)}>{t.project.back}</a>
          </p>
        </div>
      </main>
    </div>

    <div class="chrome page">
      <div class="grid chrome__grid">
        <div class="grid__info chrome__foot">
          <Footer locale={locale} route={`research/${item.slug}`} />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .screen {
    padding-block: var(--page-edge-y);
    min-height: 100svh;
  }

  .detail__media {
    aspect-ratio: 1;
    background: transparent;
  }

  .detail__info {
    display: flex;
    flex-direction: column;
    gap: var(--text-gap);
    align-self: center;
  }

  .detail__title {
    margin: 0;
  }

  .chrome {
    position: fixed;
    inset-block: var(--page-edge-y);
    inset-inline: 0;
    z-index: 1;
    pointer-events: none;
  }

  .chrome__grid {
    height: 100%;
    grid-template-rows: minmax(0, 1fr);
    align-items: stretch;
  }

  .chrome__foot {
    align-self: end;
    pointer-events: auto;
  }
</style>
