---
/**
 * Dev settings window — attach more review cases here over time.
 * Shortcut "," opens/closes the panel.
 * Cases: grid (g) · research cover marks (r)
 */
---

<aside class="dev" data-dev-settings hidden>
  <header class="dev__head">
    <span class="dev__title">Dev settings</span>
    <kbd class="dev__kbd">,</kbd>
  </header>
  <ul class="dev__list" role="list">
    <li class="dev__case">
      <label class="dev__label">
        <input type="checkbox" data-dev-case="grid" />
        <span>Grid overlay</span>
        <kbd class="dev__kbd">g</kbd>
      </label>
    </li>
    <li class="dev__case">
      <label class="dev__label">
        <input type="checkbox" data-dev-case="research-debug" />
        <span>Research cover marks</span>
        <kbd class="dev__kbd">r</kbd>
      </label>
    </li>
  </ul>
</aside>

<script>
  const STORAGE_KEY = 'ledesign-dev-settings';

  type CaseId = 'grid' | 'research-debug';

  type SettingsState = {
    open: boolean;
    cases: Record<CaseId, boolean>;
  };

  const defaultState = (): SettingsState => ({
    open: false,
    cases: { grid: false, 'research-debug': false },
  });

  const load = (): SettingsState => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return defaultState();
      const parsed = JSON.parse(raw) as Partial<SettingsState>;
      return {
        open: Boolean(parsed.open),
        cases: { ...defaultState().cases, ...parsed.cases },
      };
    } catch {
      return defaultState();
    }
  };

  const save = (state: SettingsState) => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  };

  let state = load();

  const panel = () => document.querySelector<HTMLElement>('[data-dev-settings]');
  const caseInput = (id: CaseId) =>
    document.querySelector<HTMLInputElement>(`[data-dev-case="${id}"]`);

  const setResearchDebug = (on: boolean) => {
    const feed = document.querySelector<HTMLElement>('[data-feed="research"]');
    if (!feed) return;

    feed.toggleAttribute('data-research-debug', on);
    feed.querySelectorAll('[data-research-gap-label]').forEach((el) => el.remove());
    document.querySelector('[data-research-debug-hud]')?.remove();
    if (!on || feed.hidden) return;

    const root = getComputedStyle(document.documentElement);
    const token = root.getPropertyValue('--research-row-gap').trim();
    const workGutter = root.getPropertyValue('--grid-gutter').trim();
    const researchGapPx = getComputedStyle(feed).rowGap;
    const workFeed = document.querySelector<HTMLElement>('[data-feed="work"]');
    const workGapPx = workFeed ? getComputedStyle(workFeed).rowGap : '—';

    const hud = document.createElement('div');
    hud.className = 'research-debug-hud';
    hud.dataset.researchDebugHud = '';
    hud.textContent = [
      `Research row-gap: ${researchGapPx}  (token ${token})`,
      `Work row-gap:     ${workGapPx}  (token ${workGutter})`,
      `viewport: ${window.innerWidth}px`,
    ].join('\n');
    document.body.appendChild(hud);

    const covers = [...feed.querySelectorAll<HTMLElement>('.cover--research')];
    if (covers.length < 2) return;

    const feedBox = feed.getBoundingClientRect();
    const rows: { top: number; bottom: number; left: number; right: number }[] = [];

    for (const cover of covers) {
      const box = cover.getBoundingClientRect();
      const row = rows.find((r) => Math.abs(r.top - box.top) < 2);
      if (row) {
        row.bottom = Math.max(row.bottom, box.bottom);
        row.left = Math.min(row.left, box.left);
        row.right = Math.max(row.right, box.right);
      } else {
        rows.push({ top: box.top, bottom: box.bottom, left: box.left, right: box.right });
      }
    }

    rows.sort((a, b) => a.top - b.top);

    for (let i = 0; i < rows.length - 1; i++) {
      const above = rows[i];
      const below = rows[i + 1];
      const gap = below.top - above.bottom;
      const midY = (above.bottom + below.top) / 2;
      const midX = (Math.min(above.left, below.left) + Math.max(above.right, below.right)) / 2;

      const label = document.createElement('div');
      label.className = 'research-debug-label';
      label.dataset.researchGapLabel = '';
      label.textContent = `row ${i + 1}→${i + 2}: ${gap.toFixed(1)}px`;
      label.style.left = `${midX - feedBox.left}px`;
      label.style.top = `${midY - feedBox.top}px`;
      feed.appendChild(label);
    }
  };

  const applyCase = (id: CaseId, on: boolean) => {
    state.cases[id] = on;
    const input = caseInput(id);
    if (input) input.checked = on;

    if (id === 'grid') {
      document.querySelector('[data-grid-overlay]')?.classList.toggle('is-visible', on);
    }
    if (id === 'research-debug') {
      setResearchDebug(on);
    }
  };

  const applyOpen = (open: boolean) => {
    state.open = open;
    const el = panel();
    if (!el) return;
    el.hidden = !open;
  };

  const persist = () => save(state);

  const syncFromDom = () => {
    const gridOn = Boolean(document.querySelector('[data-grid-overlay].is-visible'));
    if (gridOn !== state.cases.grid) {
      state.cases.grid = gridOn;
      const input = caseInput('grid');
      if (input) input.checked = gridOn;
      persist();
    }
  };

  const onKey = (event: KeyboardEvent) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;

    if (event.key === ',') {
      event.preventDefault();
      applyOpen(!state.open);
      persist();
      return;
    }

    if (event.key === 'g' || event.key === 'G') {
      /* GridOverlay also listens for "g" — sync checkbox after it toggles. */
      requestAnimationFrame(() => {
        syncFromDom();
      });
      return;
    }

    if (event.key === 'r' || event.key === 'R') {
      event.preventDefault();
      applyCase('research-debug', !state.cases['research-debug']);
      persist();
    }
  };

  let listenersBound = false;

  const bind = () => {
    applyOpen(state.open);
    (Object.keys(state.cases) as CaseId[]).forEach((id) => applyCase(id, state.cases[id]));

    if (listenersBound) return;
    listenersBound = true;

    caseInput('grid')?.addEventListener('change', (event) => {
      const on = (event.currentTarget as HTMLInputElement).checked;
      applyCase('grid', on);
      persist();
    });

    caseInput('research-debug')?.addEventListener('change', (event) => {
      const on = (event.currentTarget as HTMLInputElement).checked;
      applyCase('research-debug', on);
      persist();
    });

    document.addEventListener('keydown', onKey);
    window.addEventListener('resize', () => {
      if (state.cases['research-debug']) setResearchDebug(true);
    });
    document.querySelectorAll('[data-category]').forEach((btn) => {
      btn.addEventListener('click', () => {
        requestAnimationFrame(() => {
          if (state.cases['research-debug']) setResearchDebug(true);
        });
      });
    });
    window.addEventListener('hashchange', () => {
      requestAnimationFrame(() => {
        if (state.cases['research-debug']) setResearchDebug(true);
      });
    });
  };

  document.addEventListener('astro:page-load', () => {
    state = load();
    bind();
  });

  bind();
</script>

<style>
  .dev {
    position: fixed;
    inset-block-start: 12px;
    inset-inline-end: 12px;
    z-index: 1000;
    min-width: 220px;
    padding: 10px 12px;
    border: 1px solid rgb(0 0 0 / 0.18);
    background: rgb(255 255 255 / 0.96);
    color: #111;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
  }

  .dev[hidden] {
    display: none !important;
  }

  .dev__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-block-end: 8px;
    padding-block-end: 8px;
    border-block-end: 1px solid rgb(0 0 0 / 0.1);
  }

  .dev__title {
    font-weight: 600;
  }

  .dev__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dev__label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .dev__label span {
    flex: 1;
  }

  .dev__kbd {
    display: inline-block;
    min-width: 1.25rem;
    padding: 1px 5px;
    border: 1px solid rgb(0 0 0 / 0.2);
    border-radius: 3px;
    background: rgb(0 0 0 / 0.04);
    font: inherit;
    font-size: 11px;
    text-align: center;
  }

  /* Research debug marks (driven by data-research-debug on the feed). */
  :global(.feed[data-research-debug]) {
    position: relative;
  }

  :global(.feed[data-research-debug] .cover--research) {
    outline: 1px solid rgb(220 40 40);
    outline-offset: -1px;
    background: rgb(220 40 40 / 0.08);
  }

  :global(.feed[data-research-debug] .cover__hover) {
    opacity: 0 !important;
  }

  :global(.research-debug-label) {
    position: absolute;
    z-index: 5;
    transform: translate(-50%, -50%);
    padding: 2px 6px;
    border: 1px solid rgb(220 40 40);
    background: rgb(255 255 255 / 0.92);
    color: rgb(220 40 40);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
    pointer-events: none;
  }

  :global(.research-debug-hud) {
    position: fixed;
    inset-block-start: 8px;
    inset-inline-start: 50%;
    z-index: 100;
    transform: translateX(-50%);
    padding: 6px 10px;
    border: 1px solid rgb(220 40 40);
    background: rgb(255 255 255 / 0.95);
    color: rgb(220 40 40);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
    pointer-events: none;
    white-space: pre;
  }
</style>
