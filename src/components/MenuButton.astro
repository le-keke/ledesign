---
/**
 * Tablet/phone chrome control (top-right). Icon + panel design TBD from Figma.
 * Stub only — no open state yet. Visible ≤1240.
 */
---

<button class="menu" type="button" aria-label="Menu" aria-expanded="false" data-menu-button>
  <span class="menu__dots" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>

<style>
  .menu {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu__dots {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    width: 1rem;
  }

  .menu__dots span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
  }

  .menu:focus-visible {
    outline: 1px solid var(--color-exclusion-fg);
    outline-offset: 2px;
  }

  @media (max-width: 1240px) {
    .menu {
      display: inline-flex;
    }
  }
</style>
