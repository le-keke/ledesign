---
import { getDictionary, type Locale } from '@i18n/index';

interface Props {
  locale: Locale;
  active?: 'work' | 'research';
}

const { locale, active = 'work' } = Astro.props;
const t = getDictionary(locale);
---

<nav class="nav" aria-label="Categories" data-category-nav>
  <button
    class="nav__item"
    type="button"
    data-category="work"
    aria-pressed={active === 'work'}
  >
    {t.categories.work}
  </button>
  <button
    class="nav__item"
    type="button"
    data-category="research"
    aria-pressed={active === 'research'}
  >
    {t.categories.research}
  </button>
</nav>

<script>
  /**
   * ClientRouter keeps ES modules alive across navigations, so top-level
   * listeners would stick to removed DOM. Re-bind on every astro:page-load.
   */
  let abort: AbortController | null = null;

  function setCategory(category: 'work' | 'research') {
    const home = document.querySelector<HTMLElement>('[data-home]');
    if (!home) return;

    home.dataset.activeCategory = category;
    document.documentElement.dataset.homeCategory = category;

    home.querySelectorAll<HTMLElement>('[data-feed]').forEach((feed) => {
      const match = feed.dataset.feed === category;
      feed.hidden = !match;
      feed.setAttribute('aria-hidden', match ? 'false' : 'true');
    });

    home.querySelectorAll<HTMLButtonElement>('[data-category-nav] [data-category]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.category === category));
    });

    const hash = category === 'research' ? '#research' : '#work';
    if (location.hash !== hash) {
      history.replaceState(null, '', hash);
    }
  }

  function categoryFromHash(): 'work' | 'research' {
    return location.hash === '#research' ? 'research' : 'work';
  }

  function syncFromHash() {
    if (document.querySelector('[data-home]')) {
      setCategory(categoryFromHash());
    } else {
      delete document.documentElement.dataset.homeCategory;
    }
  }

  function bind() {
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;

    const home = document.querySelector<HTMLElement>('[data-home]');
    if (!home) return;

    home.querySelectorAll<HTMLButtonElement>('[data-category-nav] [data-category]').forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const category = btn.dataset.category;
          if (category === 'work' || category === 'research') {
            setCategory(category);
          }
        },
        { signal },
      );
    });

    syncFromHash();
  }

  /* after-swap: apply hash before paint on ClientRouter navigations home. */
  document.addEventListener('astro:after-swap', syncFromHash);
  document.addEventListener('astro:page-load', bind);
  window.addEventListener('hashchange', syncFromHash);
</script>

<style>
  .nav {
    display: flex;
    gap: 1.875rem; /* 30px — Figma filter tab gap */
    line-height: var(--leading-flat);
  }

  /*
   * Exclusion sources (parent uses mix-blend-mode: exclusion):
   * selected #fff → black on white; muted #3f3f3f → soft grey.
   */
  .nav__item {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    color: var(--color-exclusion-fg-muted);
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__item[aria-pressed='true'] {
    color: var(--color-exclusion-fg);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__item:hover {
      color: var(--color-exclusion-fg);
    }
  }

  .nav__item:focus {
    outline: none;
  }

  .nav__item:focus-visible {
    outline: 1px solid var(--color-exclusion-fg);
    outline-offset: 2px;
  }

</style>
