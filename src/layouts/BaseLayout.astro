---
import '@styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDictionary, localeTags, locales, type Locale } from '@i18n/index';
import MediaHydration from '@components/MediaHydration.astro';

// Dev review tools (grid + settings window). Production builds omit these.
const ENABLE_DEV_TOOLS = true;
const GridOverlay =
  import.meta.env.DEV && ENABLE_DEV_TOOLS
    ? (await import('@components/GridOverlay.astro')).default
    : null;
const DevSettings =
  import.meta.env.DEV && ENABLE_DEV_TOOLS
    ? (await import('@components/DevSettings.astro')).default
    : null;

interface Props {
  locale: Locale;
  /** Route below the locale prefix, e.g. '' for home or 'projects/slug'. */
  route?: string;
  title?: string;
  description?: string;
}

const { locale, route = '', title, description } = Astro.props;

const t = getDictionary(locale);
const pageTitle = title ? `${title} — ${t.meta.title}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(getRelativeLocaleUrl(locale, route), Astro.site);
---

<!doctype html>
<html lang={localeTags[locale]} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {/* Safari often probes /favicon.ico and caches hard on localhost. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
    <link rel="canonical" href={canonical} />

    {
      locales.map((alternate) => (
        <link
          rel="alternate"
          hreflang={localeTags[alternate]}
          href={new URL(getRelativeLocaleUrl(alternate, route), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getRelativeLocaleUrl('en', route), Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />

    <slot name="head" />
    {/* Instant swap (no fade); keep client router so session cache can reuse pages. */}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
    {GridOverlay && <GridOverlay />}
    {DevSettings && <DevSettings />}
    <MediaHydration />
    <script>
      import { installSessionNavCache } from '../scripts/session-nav-cache';
      import { installInfoPanel } from '../scripts/info-panel';
      installSessionNavCache();
      installInfoPanel();
    </script>
  </body>
</html>
